# AI Travel Planner - Environment Variables
# Copy this file to .env and fill in your API keys

# Port for Express backend API server
PORT=5000

# Gemini API Key (required for live AI itinerary + chat)
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# OpenWeather API Key (optional - enables real weather data)
# Get free key at: https://openweathermap.org/api
WEATHER_API_KEY=your_openweather_key_here

# MongoDB connection string (optional - defaults to local JSON file storage)
# Example: mongodb://localhost:27017/ai-travel-planner
MONGO_URI=
