# AI Travel Planner - Environment Variables
# Copy this file to .env and fill in your API keys

# Port for Express backend API server
PORT=5000

# JWT Secret for authentication tokens (REQUIRED for security)
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Frontend URL(s) for CORS — comma-separated for multiple origins
# Examples: http://localhost:5173,https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Gemini API Key (required for live AI itinerary + chat)
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# OpenWeather API Key (optional - enables real weather data)
# Get free key at: https://openweathermap.org/api
WEATHER_API_KEY=your_openweather_key_here

# MongoDB connection string (optional - defaults to local JSON file storage)
# Example: mongodb://localhost:27017/ai-travel-planner
MONGO_URI=

# Duffel Flights API Token (optional - enables real flight search via Duffel Flights API v2)
# Get test token at: https://duffel.com
# Test tokens start with duffel_test_; Live tokens start with duffel_live_
DUFFEL_API_KEY=
